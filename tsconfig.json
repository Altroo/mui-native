{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "paths": {
      "@altroo/mui-native-system": ["./packages/system/src/index.ts"],
      "@altroo/mui-native": ["./packages/material/src/index.ts"],
      "@altroo/mui-native/*": ["./packages/material/src/*/index.ts"],
      "@altroo/mui-native-icons": ["./packages/icons/src/index.ts"],
      "@altroo/mui-native-x-tree-view": ["./packages/x-tree-view/src/index.ts"],
      "@altroo/mui-native-x-data-grid": ["./packages/x-data-grid/src/index.ts"],
      "@altroo/mui-native-x-charts": ["./packages/x-charts/src/index.ts"],
      "@altroo/mui-native-x-date-pickers": ["./packages/x-date-pickers/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["**/dist", "node_modules"]
}
