{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "paths": {
      "@altroo/mui-native-system": ["./packages/system/src/index.ts"],
      "@altroo/mui-native": ["./packages/material/src/index.ts"],
      "@altroo/mui-native/*": ["./packages/material/src/*/index.ts"],
      "@altroo/mui-native-icons": ["./packages/icons/src/index.ts"],
      "@altroo/mui-native-x-tree-view": ["./packages/x-tree-view/src/index.ts"],
      "@altroo/mui-native-x-data-grid": ["./packages/x-data-grid/src/index.ts"],
      "@altroo/mui-native-x-charts": ["./packages/x-charts/src/index.ts"],
      "@altroo/mui-native-x-date-pickers": ["./packages/x-date-pickers/src/index.ts"],
      "@mui/material": ["./packages/material/src/index.ts"],
      "@mui/x-data-grid": ["./packages/x-data-grid/src/index.ts"],
      "@altroo/mui-native-host": ["./packages/native-host/src/index.tsx"],
      "@altroo/mui-native-host/internal/owned-view": [
        "./packages/native-host/src/internal/owned-view/index.ts"
      ],
      "@altroo/mui-native-system/internal/prepared-style": [
        "./packages/system/src/internal/prepared-style/index.ts"
      ],
      "@altroo/mui-native-system/DefaultPropsProvider": [
        "./packages/system/src/DefaultPropsProvider/index.ts"
      ],
      "@mui/icons-material/*": ["./packages/icons/src/*"],
      "@altroo/mui-native-icons/*": ["./packages/icons/src/*"],
      "@altroo/mui-native-system/internal/generated-paragraph": [
        "./packages/system/src/internal/generated-paragraph/index.ts"
      ],
      "@altroo/mui-native-host/internal/native-keys": [
        "./packages/native-host/src/internal/native-keys/index.ts"
      ],
      "@altroo/mui-native-host/internal/structural-observation": [
        "./packages/native-host/src/internal/structural-observation/index.ts"
      ],
      "@altroo/mui-native-host/internal/pressable-presentation": [
        "./packages/native-host/src/internal/pressable-presentation/index.ts"
      ],
      "@altroo/mui-native-host/internal/structural-root": [
        "./packages/native-host/src/internal/structural-root/index.ts"
      ]
    },
    "customConditions": ["react-native"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["**/dist", "node_modules"]
}
