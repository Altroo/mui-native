{
  "name": "@altroo/mui-native-system",
  "version": "0.0.6-prealpha.0",
  "description": "Native theme and styling foundations for MUI Native. Experimental pre-alpha.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altroo/mui-native.git",
    "directory": "packages/system"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./colorManipulator": {
      "types": "./dist/colorManipulator/index.d.ts",
      "react-native": "./src/colorManipulator/index.ts",
      "default": "./dist/colorManipulator/index.js"
    },
    "./DefaultPropsProvider": {
      "types": "./dist/DefaultPropsProvider/index.d.ts",
      "react-native": "./src/DefaultPropsProvider/index.ts",
      "default": "./dist/DefaultPropsProvider/index.js"
    },
    "./useThemeProps": {
      "types": "./dist/useThemeProps/index.d.ts",
      "react-native": "./src/useThemeProps/index.ts",
      "default": "./dist/useThemeProps/index.js"
    },
    "./ThemeProvider": {
      "types": "./dist/ThemeProvider/index.d.ts",
      "react-native": "./src/ThemeProvider/index.ts",
      "default": "./dist/ThemeProvider/index.js"
    },
    "./useTheme": {
      "types": "./dist/useTheme/index.d.ts",
      "react-native": "./src/useTheme/index.ts",
      "default": "./dist/useTheme/index.js"
    },
    "./useThemeWithoutDefault": {
      "types": "./dist/useThemeWithoutDefault/index.d.ts",
      "react-native": "./src/useThemeWithoutDefault/index.ts",
      "default": "./dist/useThemeWithoutDefault/index.js"
    },
    "./RtlProvider": {
      "types": "./dist/RtlProvider/index.d.ts",
      "react-native": "./src/RtlProvider/index.tsx",
      "default": "./dist/RtlProvider/index.js"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.1 <0.89"
  },
  "publishConfig": {
    "access": "public",
    "tag": "prealpha",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "author": "Altroo",
  "homepage": "https://github.com/Altroo/mui-native#readme",
  "bugs": {
    "url": "https://github.com/Altroo/mui-native/issues"
  }
}
