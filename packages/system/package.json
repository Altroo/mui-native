{
  "name": "@altroo/mui-native-system",
  "version": "0.0.0-dev.0",
  "description": "Independent native compatibility for @mui/system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Altroo/mui-native.git",
    "directory": "packages/system"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./colorManipulator": {
      "types": "./dist/colorManipulator/index.d.ts",
      "react-native": "./src/colorManipulator/index.ts",
      "default": "./dist/colorManipulator/index.js"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.1 <0.89"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
