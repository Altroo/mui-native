{
  "name": "@altroo/mui-native-icons",
  "version": "0.0.7-prealpha.0",
  "description": "Experimental native SVG icons for MUI Native.",
  "keywords": [
    "mui-native",
    "react-native",
    "material-ui",
    "mui",
    "icons"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altroo/mui-native.git",
    "directory": "packages/icons"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.material-icons"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "react-native": "./src/*/index.ts",
      "import": "./dist/esm/*/index.mjs",
      "require": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "dependencies": {
    "@altroo/mui-native-system": "workspace:*",
    "@altroo/mui-native": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.1 <0.89",
    "react-native-svg": ">=15.15.4 <16"
  },
  "publishConfig": {
    "access": "public",
    "tag": "prealpha",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "author": "Altroo",
  "homepage": "https://github.com/Altroo/mui-native#readme",
  "bugs": {
    "url": "https://github.com/Altroo/mui-native/issues"
  },
  "module": "./dist/esm/index.mjs"
}
