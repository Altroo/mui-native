{
  "name": "@altroo/mui-native-host",
  "version": "0.0.7-prealpha.0",
  "description": "Fabric interaction, portal and platform picker hosts for MUI Native.",
  "keywords": [
    "mui-native",
    "react-native",
    "material-ui",
    "mui",
    "native-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altroo/mui-native.git",
    "directory": "packages/native-host"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.tsx",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "android",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "ios",
    "AltrooMuiNativeHost.podspec",
    "react-native.config.js",
    "LICENSE",
    "NOTICE",
    "common",
    "README.md",
    "scripts/verify-native-input.cjs",
    "native-input-baseline.json",
    "structural-observation-baseline.json",
    "scripts/verify-structural-input.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.tsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./internal/owned-view": {
      "types": "./dist/internal/owned-view/index.d.ts",
      "react-native": "./src/internal/owned-view/index.ts",
      "default": "./dist/internal/owned-view/index.js"
    },
    "./internal/native-keys": {
      "types": "./dist/internal/native-keys/index.d.ts",
      "react-native": "./src/internal/native-keys/index.ts",
      "default": "./dist/internal/native-keys/index.js"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=19.3.0 <20",
    "react-native": "0.88.1"
  },
  "codegenConfig": {
    "name": "AltrooMuiNativeHostSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.altroo.muinativehost"
    },
    "ios": {
      "componentProvider": {
        "AltrooMUIInteractiveView": "AltrooMUIInteractiveViewComponentView",
        "AltrooMUINativePicker": "AltrooMUINativePickerComponentView",
        "AltrooMUIPortalHost": "AltrooMUIPortalHostComponentView",
        "AltrooMUIPortalCanvas": "AltrooMUIPortalCanvasComponentView",
        "AltrooMUITextInput": "AltrooMUITextInputComponentView",
        "AltrooMUIStructuralView": "AltrooMUIStructuralViewComponentView"
      },
      "modulesProvider": {
        "AltrooStructuralObserver": "AltrooStructuralObserverProvider",
        "AltrooPrelayoutProbe": "AltrooPrelayoutProbeProvider"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "prealpha",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "author": "Altroo",
  "homepage": "https://github.com/Altroo/mui-native#readme",
  "bugs": {
    "url": "https://github.com/Altroo/mui-native/issues"
  }
}
