{
  "name": "mui-native-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/native-catalog/tsconfig.json",
    "test": "jest --runInBand && node --test scripts/inventory/*.test.mjs scripts/upstream/*.test.mjs packages/compat/*.test.cjs",
    "check": "pnpm typecheck && pnpm test && pnpm coverage:verify && pnpm build",
    "upstream:check": "node scripts/upstream/detect.mjs",
    "upstream:baseline": "node scripts/upstream/baseline.mjs",
    "catalog": "pnpm --filter native-catalog start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:all": "node scripts/pack.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "upstream:simulate": "node scripts/upstream/simulate.mjs",
    "coverage:generate": "node scripts/inventory/generate.mjs",
    "coverage:check": "node scripts/inventory/generate.mjs --check",
    "coverage:verify": "node scripts/inventory/freshness.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "^19.0.0",
    "@testing-library/react-native": "13.3.3",
    "react-test-renderer": "19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "jest": "30.5.2",
    "babel-jest": "30.5.2",
    "typescript": "7.0.2",
    "esbuild": "^0.25.0",
    "semver": "^7.7.0",
    "@react-native/jest-preset": "0.88.1",
    "prettier": "3.6.2",
    "@shopify/flash-list": "2.3.2",
    "dayjs": "1.11.13"
  }
}
