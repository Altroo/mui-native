    {
      "name": "bare text excludes Typography component defaults",
      "label": "Bare default",
      "theme": {
        "components": {
          "MuiTypography": {
            "defaultProps": {
              "variant": "h1"
            },
            "styleOverrides": {
              "root": {
                "fontSize": 99,
