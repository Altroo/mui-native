{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["react-native"],
    "paths": {
      "@altroo/mui-native-system": ["../../packages/system/src/index.ts"],
      "@altroo/mui-native-host": ["../../packages/native-host/src/index.tsx"],
      "@altroo/mui-native": ["../../packages/material/src/index.ts"],
      "@altroo/mui-native/*": ["../../packages/material/src/*/index.ts"],
      "@mui/material": ["../../packages/material/src/index.ts"],
      "@mui/material/*": ["../../packages/material/src/*/index.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
