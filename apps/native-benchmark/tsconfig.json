{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["react-native"],
    "paths": {
      "@altroo/mui-native-system": ["../../packages/system/src/index.ts"],
      "@altroo/mui-native-host": ["../../packages/native-host/src/index.tsx"],
      "@altroo/mui-native": ["../../packages/material/src/index.ts"],
      "@altroo/mui-native/*": ["../../packages/material/src/*/index.ts"],
      "@mui/material": ["../../packages/material/src/index.ts"],
      "@mui/material/*": ["../../packages/material/src/*/index.ts"],
      "@altroo/mui-native-host/internal/owned-view": [
        "../../packages/native-host/src/internal/owned-view/index.ts"
      ],
      "@altroo/mui-native-system/internal/prepared-style": [
        "../../packages/system/src/internal/prepared-style/index.ts"
      ],
      "@altroo/mui-native-system/internal/generated-paragraph": [
        "../../packages/system/src/internal/generated-paragraph/index.ts"
      ],
      "@altroo/mui-native-host/internal/structural-observation": [
        "../../packages/native-host/src/internal/structural-observation/index.ts"
      ],
      "@altroo/mui-native-host/internal/pressable-presentation": [
        "../../packages/native-host/src/internal/pressable-presentation/index.ts"
      ],
      "@altroo/mui-native-host/internal/structural-root": [
        "../../packages/native-host/src/internal/structural-root/index.ts"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
