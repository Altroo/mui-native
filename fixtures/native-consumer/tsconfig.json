{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "customConditions": ["react-native"],
    "paths": {
      "@altroo/mui-native": ["../../packages/material/dist/index.d.ts"],
      "@altroo/mui-native-host": ["../../packages/native-host/dist/index.d.ts"],
      "@altroo/mui-native-host/*": ["../../packages/native-host/dist/*/index.d.ts"],
      "@altroo/mui-native-icons": ["../../packages/icons/dist/index.d.ts"],
      "@altroo/mui-native-icons/*": ["../../packages/icons/dist/*/index.d.ts"],
      "@altroo/mui-native-system": ["../../packages/system/dist/index.d.ts"],
      "@altroo/mui-native-system/*": ["../../packages/system/dist/*/index.d.ts"],
      "@altroo/mui-native-x-charts": ["../../packages/x-charts/dist/index.d.ts"],
      "@altroo/mui-native-x-charts/*": ["../../packages/x-charts/dist/*/index.d.ts"],
      "@altroo/mui-native-x-data-grid": ["../../packages/x-data-grid/dist/index.d.ts"],
      "@altroo/mui-native-x-data-grid/*": ["../../packages/x-data-grid/dist/*/index.d.ts"],
      "@altroo/mui-native-x-date-pickers": ["../../packages/x-date-pickers/dist/index.d.ts"],
      "@altroo/mui-native-x-date-pickers/*": ["../../packages/x-date-pickers/dist/*/index.d.ts"],
      "@altroo/mui-native-x-tree-view": ["../../packages/x-tree-view/dist/index.d.ts"],
      "@altroo/mui-native-x-tree-view/*": ["../../packages/x-tree-view/dist/*/index.d.ts"],
      "@altroo/mui-native/*": ["../../packages/material/dist/*/index.d.ts"],
      "@mui/icons-material": ["../../packages/icons/dist/index.d.ts"],
      "@mui/icons-material/*": ["../../packages/icons/dist/*/index.d.ts"],
      "@mui/material": ["../../packages/material/dist/index.d.ts"],
      "@mui/material/*": ["../../packages/material/dist/*/index.d.ts"],
      "@mui/system": ["../../packages/system/dist/index.d.ts"],
      "@mui/system/*": ["../../packages/system/dist/*/index.d.ts"],
      "@mui/x-charts": ["../../packages/x-charts/dist/index.d.ts"],
      "@mui/x-charts/*": ["../../packages/x-charts/dist/*/index.d.ts"],
      "@mui/x-data-grid": ["../../packages/x-data-grid/dist/index.d.ts"],
      "@mui/x-data-grid/*": ["../../packages/x-data-grid/dist/*/index.d.ts"],
      "@mui/x-date-pickers": ["../../packages/x-date-pickers/dist/index.d.ts"],
      "@mui/x-date-pickers/*": ["../../packages/x-date-pickers/dist/*/index.d.ts"],
      "@mui/x-tree-view": ["../../packages/x-tree-view/dist/index.d.ts"],
      "@mui/x-tree-view/*": ["../../packages/x-tree-view/dist/*/index.d.ts"]
    }
  },
  "include": ["*.tsx"]
}
